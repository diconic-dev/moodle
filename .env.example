# Salin ke .env lalu sesuaikan. JANGAN commit file .env.
#   cp .env.example .env

# --- Database ---------------------------------------------------------------
# Pakai password kuat; container ini terekspos ke jaringan docker internal.
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=ganti-dengan-password-kuat
MOODLE_DB_ROOT_PASSWORD=ganti-dengan-root-password-kuat

# --- Image production -------------------------------------------------------
# Gunakan tag release immutable yang sudah dipush oleh GitHub Actions ke GHCR.
MOODLE_IMAGE=ghcr.io/diconic-dev/moodle
MOODLE_IMAGE_TAG=5.3.1
MOODLE_WEB_IMAGE=ghcr.io/diconic-dev/moodle

# --- Akses ------------------------------------------------------------------
# PENTING: harus sama persis dengan URL yang dipakai di browser.
# Kalau beda, Moodle akan redirect loop dan aset 404.
# Untuk development gunakan localhost; untuk production gunakan https:// dan domain asli.
MOODLE_WWWROOT=http://localhost:8080
MOODLE_HTTP_PORT=8080

# --- Lain-lain --------------------------------------------------------------
MOODLE_SITE_LANG=id

# Docker nginx meneruskan request ke PHP-FPM, jadi reverse proxy harus aktif.
MOODLE_REVERSEPROXY=1
MOODLE_SSLPROXY=0

TZ=Asia/Jakarta