# Salin ke .env lalu sesuaikan. JANGAN commit file .env.
#   cp .env.example .env

# --- Database ---------------------------------------------------------------
# Pakai password kuat; container ini terekspos ke jaringan docker internal.
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=ganti-dengan-password-kuat
MOODLE_DB_ROOT_PASSWORD=ganti-dengan-root-password-kuat

# --- Akses ------------------------------------------------------------------
# PENTING: harus sama persis dengan URL yang dipakai di browser.
# Kalau beda, Moodle akan redirect loop dan aset 404.
# Untuk produksi pakai https:// dan domain asli.
MOODLE_WWWROOT=http://localhost:8080
MOODLE_HTTP_PORT=8080

# --- Lain-lain --------------------------------------------------------------
MOODLE_SITE_LANG=id

# Set ke 1 kalau ada reverse proxy / load balancer di depan nginx.
MOODLE_REVERSEPROXY=0
MOODLE_SSLPROXY=0

TZ=Asia/Jakarta